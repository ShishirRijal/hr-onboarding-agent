# LLM
OPENAI_API_KEY=sk-...

# Tracing: each question's run of the agent is sent to Langfuse when both keys are set,
# with employees' names and email addresses masked. Leave them empty to turn it off.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# https://cloud.langfuse.com (EU) or https://us.cloud.langfuse.com (US), or your own instance.
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Reranker (optional; the trial key is limited to 10 calls/minute)
COHERE_API_KEY=...
USE_COHERE_RERANK=false

# Corrective RAG: grade the found sections and search again for what they leave out (~1s slower)
CORRECTIVE_SEARCH=false

# Monthly spending limit in US dollars for the assistant's OpenAI calls, at list prices.
# Once it's reached, the assistant stops answering until next month and points employees to HR.
# Empty means no limit. Usage and cost are on the HR platform's Usage page.
MONTHLY_BUDGET_USD=

# Vector DB (local Qdrant via Docker)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=nordtech_hr

# App
APP_ENV=development
LOG_LEVEL=INFO
# Chats, the HR inbox, model usage and accounts: the Postgres from docker-compose (port 5433).
# Without it set, the app uses a SQLite file at data/interactions.db.
INTERACTIONS_DATABASE_URL=postgresql+psycopg://hr:hr-local@localhost:5433/hr_onboarding
WEB_ORIGINS=http://localhost:3000
# Folder the API reads source documents from when a cited source is opened.
CORPUS_DIR=corpus
# Sign-in: set to true when the app is served over HTTPS, so the session cookie is only sent there.
SESSION_COOKIE_SECURE=false

# HR digest: one email a day to HR with the questions employees asked to send them.
# Defaults point at Mailpit from docker-compose (inbox at http://localhost:8025).
HR_DIGEST_TO=hr@nordtech.test
HR_DIGEST_FROM=hr-assistant@nordtech.test
# The HR inbox in the web app; the email links each question there.
HR_INBOX_URL=http://localhost:3000/hr
# Local time to send it ("HH:MM"); leave empty to turn the daily email off.
HR_DIGEST_TIME=18:00
HR_DIGEST_TIMEZONE=Europe/Tallinn
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
