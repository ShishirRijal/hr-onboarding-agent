# LLM
OPENAI_API_KEY=sk-...

# Observability
LANGSMITH_API_KEY=ls__...
LANGSMITH_PROJECT=hr-onboarding-agent

# Reranker (optional; the trial key is limited to 10 calls/minute)
COHERE_API_KEY=...
USE_COHERE_RERANK=false

# Vector DB (local Qdrant via Docker)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=nordtech_hr

# App
APP_ENV=development
LOG_LEVEL=INFO
INTERACTIONS_DATABASE_URL=sqlite:///data/interactions.db
WEB_ORIGINS=http://localhost:3000
# Folder the API reads source documents from when a cited source is opened.
CORPUS_DIR=corpus
# Sign-in: set to true when the app is served over HTTPS, so the session cookie is only sent there.
SESSION_COOKIE_SECURE=false

# HR digest: one email a day to HR with the questions employees asked to send them.
# Defaults point at Mailpit from docker-compose (inbox at http://localhost:8025).
HR_DIGEST_TO=hr@nordtech.test
HR_DIGEST_FROM=hr-assistant@nordtech.test
# The HR inbox in the web app; the email links each question there.
HR_INBOX_URL=http://localhost:3000/hr
# Local time to send it ("HH:MM"); leave empty to turn the daily email off.
HR_DIGEST_TIME=18:00
HR_DIGEST_TIMEZONE=Europe/Tallinn
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
